NEXT_PUBLIC_SOLANA_CLUSTER=mainnet
NEXT_PUBLIC_SITE_NAME=Retrograve Customizer
HELIUS_API_KEY=put_your_helius_key_here

# Strategy A (preferred): verified collection address
COLLECTION_ADDRESS=Enter_Your_Collection_Address

# Strategy B: creator address (leave COLLECTION_ADDRESS empty if set)
#CREATOR_ADDRESS=Enter_Creator_Address

# Optional during testing: bypass wallets (comma-separated pubkeys)
DEV_BYPASS_WALLETS=


# LockScreened Creator Studio (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IMPORTANT:
# - Never place a Supabase service_role / secret key in NEXT_PUBLIC_ variables.
# - Creator Studio can run in local-preview mode when these are blank.
# - Production persistence is enabled only after the dedicated LockScreened
#   Supabase project is configured.
